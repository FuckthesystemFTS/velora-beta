{
  "name": "creatorspeaker-tv",
  "version": "1.0.0",
  "description": "CreatorSpeaker TV platform with public site, user dashboard, admin panel, and affiliate offers automation.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node src/db/seed.js",
    "db:migrate": "node src/db/index.js --migrate",
    "check:public": "node scripts/check-public-clean.js",
    "check:subscriptions": "node scripts/check-subscriptions-visible-credentials-flow.js",
    "check:secret-leaks": "node scripts/check-no-public-secret-leaks.js",
    "check:cms": "node scripts/check-admin-cms-cloudinary.js",
    "check:admin-final": "node scripts/check-admin-final-operational.js",
    "check:admin-links": "node scripts/check-admin-links.js",
    "check:admin-copy": "node scripts/check-admin-ui-copy.js",
    "check:public-leaks": "node scripts/check-public-no-admin-leaks.js",
    "check:video-studio": "node scripts/check-video-studio-advanced.js",
    "check:video-archive": "node scripts/check-video-archive-security.js",
    "check:outreach-search": "node scripts/check-outreach-search.js",
    "check:outreach-email": "node scripts/check-outreach-email.js",
    "check:outreach-security": "node scripts/check-outreach-security.js",
    "check:affiliate-amazon": "node scripts/check-amazon-deals-integration.js",
