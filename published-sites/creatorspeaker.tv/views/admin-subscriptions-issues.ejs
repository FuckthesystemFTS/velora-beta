<section class="admin-section">
  <div class="shell admin-shell-inner">
    <p class="eyebrow">Segnalazioni</p>
    <h1>Problemi inviati dagli utenti</h1>
    <div class="table-list top-gap">
      <% page.issues.forEach(function(issue) { %>
        <article class="admin-card">
          <div class="admin-row split-admin-row">
            <div>
              <strong><%= issue.user_name %> · <%= issue.platform_name %></strong>
              <p class="muted"><%= issue.issue_type %> · <%= issue.status_label %></p>
            </div>
            <p class="muted"><%= issue.created_at %></p>
          </div>
          <p class="muted"><%= issue.message %></p>
          <form class="stack-form top-gap" method="post" action="/admin/abbonamenti/segnalazioni/<%= issue.id %>">
            <%- include("partials/csrf-fields") %>
            <label>Stato
              <select name="status">
                <option value="open" <%= issue.status === 'open' ? 'selected' : '' %>>open</option>
                <option value="in_progress" <%= issue.status === 'in_progress' ? 'selected' : '' %>>in_progress</option>
                <option value="closed" <%= issue.status === 'closed' ? 'selected' : '' %>>closed</option>
              </select>
            </label>
            <label>Risposta admin<textarea name="admin_reply"><%= issue.admin_reply || '' %></textarea></label>
            <button class="button secondary" type="submit">Aggiorna segnalazione</button>
          </form>
        </article>
      <% }) %>
    </div>
  </div>
</section>
