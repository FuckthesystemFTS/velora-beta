<section class="page-section">
  <div class="shell">
    <div class="streaming-heading">
      <div>
        <p class="eyebrow">Archivio video</p>
        <h1>I miei video</h1>
        <p class="muted">Qui trovi elaborazioni in corso, video completati, errori e rimborsi crediti</p>
      </div>
      <a class="button compact" href="/dashboard/video-studio">Crea nuovo video</a>
    </div>

    <div class="table-list">
      <% if (!data.jobs.length) { %>
        <div class="admin-empty-state">
          <strong>Nessun video creato</strong>
          <span>Avvia una generazione dal Video Studio</span>
        </div>
      <% } %>
      <% data.jobs.forEach(function(job) { %>
        <article class="admin-row split-admin-row" data-job-status data-job-status-url="/dashboard/video-jobs/<%= job.id %>/status" data-job-refresh-ms="5000">
          <div>
            <strong><%= job.title %></strong>
            <p><%= job.profile_label %> - <%= job.aspect_ratio || job.format %> - <%= job.credits_charged || job.credits_cost %> crediti</p>
            <p>Stato <span data-job-status-label><%= job.status_label %></span> - avanzamento <strong data-job-progress-text><%= job.progress_percent %>%</strong></p>
            <div class="upload-progress">
              <div class="upload-progress-bar" style="width: <%= job.progress_percent %>%" data-job-progress-bar role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= job.progress_percent %>"></div>
            </div>
            <p class="muted" data-job-status-detail><%= job.status_detail || "" %></p>
            <% if (job.error_message) { %><p class="muted"><%= job.error_message %></p><% } %>
          </div>
          <div class="inline-actions">
            <a class="ghost-button compact-ghost" href="/dashboard/videos/<%= job.id %>">Apri</a>
            <% if (job.output_url) { %><a class="button compact secondary" href="<%= job.output_url %>" data-job-output-link>Scarica</a><% } else { %><a class="button compact secondary" href="#" data-job-output-link hidden>Scarica</a><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
