<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <meta
      name="description"
      content="Area riservata CreatorSpeaker TV per gestire ordini, contenuti, crediti e servizi"
    />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon.png" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="user-body">
    <%- include("partials/user-header", { data, currentUser }) %>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>">
        <div class="shell"><%= flash.message %></div>
      </div>
    <% } %>

    <main>
      <%- include(bodyTemplate, { data, page, currentUser }) %>
    </main>

    <script src="/js/app.js"></script>
    <% if (currentPath.startsWith("/dashboard/video-studio") || currentPath.startsWith("/dashboard/video-jobs") || currentPath.startsWith("/dashboard/videos")) { %>
      <script src="/js/video-studio.js"></script>
    <% } %>
  </body>
</html>
