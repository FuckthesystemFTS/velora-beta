<section class="admin-section">
  <div class="shell admin-shell-inner">
    <div class="streaming-heading">
      <div>
        <p class="eyebrow">Richieste</p>
        <h1>Richieste abbonamento</h1>
      </div>
      <div class="inline-actions">
        <a class="ghost-button compact-ghost" href="/admin/abbonamenti/richieste?filter=all">Tutte</a>
        <a class="ghost-button compact-ghost" href="/admin/abbonamenti/richieste?filter=pending">In attesa</a>
        <a class="ghost-button compact-ghost" href="/admin/abbonamenti/richieste?filter=payment_check">Da verificare</a>
      </div>
    </div>
    <div class="table-list top-gap">
      <% page.requests.forEach(function(request) { %>
        <div class="admin-row split-admin-row">
          <div>
            <strong><%= request.user_name || request.full_name %></strong>
            <p class="muted"><%= request.platform_name %> · <%= request.status_label %> · <%= request.payment_status_label %> · <%= request.created_at %></p>
          </div>
          <div class="inline-actions">
            <a class="ghost-button compact-ghost" href="/admin/abbonamenti/richieste/<%= request.id %>">Apri</a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
