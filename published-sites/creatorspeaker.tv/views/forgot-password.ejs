<section class="auth-section">
  <div class="shell auth-grid">
    <article class="auth-copy">
      <p class="eyebrow">Recupero password</p>
      <h1>Ricevi un link sicuro</h1>
      <p>Inserisci la mail usata in registrazione. Se l account esiste riceverai un link valido per 60 minuti</p>
    </article>
    <form class="auth-card" action="/password-dimenticata" method="post">
      <%- include("partials/csrf-fields") %>
      <label>Email<input type="email" name="email" required /></label>
      <button class="button" type="submit">Invia link</button>
      <p class="muted">Ti ricordi la password? <a href="/login">Accedi</a></p>
    </form>
  </div>
</section>
