<section class="auth-section">
  <div class="shell auth-grid">
    <article class="auth-copy">
      <p class="eyebrow">Nuova password</p>
      <h1>Imposta un nuovo accesso</h1>
      <p>Scegli una password nuova e confermala. Dopo il salvataggio potrai accedere subito</p>
    </article>
    <form class="auth-card" action="/reset-password/<%= data.token %>" method="post">
      <%- include("partials/csrf-fields") %>
      <label>Nuova password<input type="password" name="password" minlength="8" required /></label>
      <label>Conferma password<input type="password" name="confirm_password" minlength="8" required /></label>
      <button class="button" type="submit">Salva password</button>
    </form>
  </div>
</section>
