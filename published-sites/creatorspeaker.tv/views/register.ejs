<section class="auth-section">
  <div class="shell auth-grid">
    <article class="auth-copy">
      <p class="eyebrow">Nuovo account</p>
      <h1>Crea il tuo accesso</h1>
      <p>Apri il tuo spazio personale per inviare contenuti, seguire le richieste e usare gli strumenti del network</p>
    </article>
    <form class="auth-card" action="/register" method="post">
      <%- include("partials/csrf-fields") %>
      <label>Nome e cognome<input type="text" name="name" required /></label>
      <label>Email<input type="email" name="email" required /></label>
      <label>Password<input type="password" name="password" minlength="8" required /></label>
      <label>Conferma password<input type="password" name="confirm_password" minlength="8" required /></label>
      <label class="checkbox"><input type="checkbox" name="accept_legal" required /> Accetto privacy e termini</label>
      <button class="button" type="submit">Crea account</button>
    </form>
  </div>
</section>
