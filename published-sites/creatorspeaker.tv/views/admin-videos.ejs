<section class="admin-section">
  <div class="shell">
    <div class="streaming-heading">
      <div>
        <h1>Archivio video</h1>
        <p class="muted">Output completati, job in corso, errori e rimborsi con accesso rapido ai dettagli</p>
      </div>
      <div class="inline-actions">
        <a class="<%= !data.status ? 'button compact' : 'ghost-button compact-ghost' %>" href="/admin/videos">Tutti</a>
        <a class="<%= data.status === 'completed' ? 'button compact' : 'ghost-button compact-ghost' %>" href="/admin/videos?status=completed">Completati</a>
        <a class="<%= data.status === 'processing' ? 'button compact' : 'ghost-button compact-ghost' %>" href="/admin/videos?status=processing">In corso</a>
        <a class="ghost-button compact-ghost" href="/admin/video-profiles">Profili</a>
      </div>
    </div>

    <div class="table-list">
      <% if (!data.jobs.length) { %>
        <div class="admin-empty-state">
          <strong>Nessun video trovato</strong>
          <span>Cambia filtro o attendi nuove elaborazioni</span>
        </div>
      <% } %>
      <% data.jobs.forEach(function(job) { %>
        <article class="admin-row split-admin-row" data-job-status data-job-status-url="/admin/video-jobs/<%= job.id %>/status" data-job-refresh-ms="5000">
          <div>
            <strong><%= job.title %></strong>
            <p><%= job.user_name || job.user_email || "Utente" %> - <%= job.profile_name || job.style %> - <%= job.aspect_ratio || job.format %></p>
            <p>Stato <span data-job-status-label><%= job.status %></span> - avanzamento <strong data-job-progress-text><%= job.progress_percent %>%</strong> - <%= job.credits_charged || job.credits_cost %> crediti</p>
            <div class="upload-progress">
              <div class="upload-progress-bar" style="width: <%= job.progress_percent %>%" data-job-progress-bar role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= job.progress_percent %>"></div>
            </div>
            <p class="muted" data-job-status-detail><%= job.status_detail || "" %></p>
          </div>
          <div class="inline-actions">
            <a class="ghost-button compact-ghost" href="/admin/videos/<%= job.id %>">Apri</a>
            <% if (job.output_url) { %><a class="button compact secondary" href="<%= job.output_url %>" data-job-output-link>Scarica</a><% } else { %><a class="button compact secondary" href="#" data-job-output-link hidden>Scarica</a><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
