<section class="splash-screen">
  <div class="splash-card">
    <img src="/images/splash-happymeter.jpg" alt="Splash HappyMeter" class="splash-image" />
    <div class="splash-copy">
      <span class="eyebrow">HappyMeter / Feliciometro</span>
      <h1><%= copy('Due tap e sei dentro', 'Two taps and you are in') %></h1>
      <p><%= copy('Se vuoi rivedere l introduzione o cambiare lingua al primo sguardo, qui trovi una porta semplice verso tutto il resto dell app', 'If you want to revisit the intro or change language at first glance, this is a simple doorway into the rest of the app') %></p>
      <div class="cta-stack">
        <a href="/welcome" class="primary-btn"><%= copy('Apri le prepagine', 'Open the welcome screens') %></a>
        <a href="/" class="secondary-btn"><%= copy('Vai alla home', 'Go to the home page') %></a>
      </div>
    </div>
  </div>
</section>
