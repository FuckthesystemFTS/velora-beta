<section class="admin-panel">
  <h2>Nuova attività felice</h2>
  <form method="post" action="/admin/activities" class="stack-form two-col">
    <label>Nome IT<input type="text" name="name_it" required /></label>
    <label>Nome EN<input type="text" name="name_en" /></label>
    <label>Descrizione IT<textarea name="description_it" rows="2" required></textarea></label>
    <label>Descrizione EN<textarea name="description_en" rows="2"></textarea></label>
    <label>Categoria<input type="text" name="category" value="custom" /></label>
    <label>Punti<input type="number" name="points" value="10" min="1" max="100" /></label>
    <label>Icona<input type="text" name="icon" value="✨" /></label>
    <label><input type="checkbox" name="active" value="1" checked /> Attiva</label>
    <button type="submit" class="primary-btn">Crea attività</button>
  </form>
</section>

<section class="admin-panel">
  <h2>Catalogo attività</h2>
  <table class="admin-table">
    <thead><tr><th>Nome</th><th>Categoria</th><th>Punti</th><th>Stato</th><th></th></tr></thead>
    <tbody>
      <% activities.forEach((item) => { %>
        <tr>
          <td><%= item.name_it %></td>
          <td><%= item.category %></td>
          <td><%= item.points %></td>
          <td><%= Number(item.active) === 1 ? 'Attiva' : 'Disattiva' %></td>
          <td>
            <form method="post" action="/admin/activities/<%= item.id %>/toggle">
              <button type="submit" class="ghost-btn">Toggle</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
