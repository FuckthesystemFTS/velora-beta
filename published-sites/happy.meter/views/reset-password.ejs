<section class="auth-wrap">
  <div class="auth-card">
    <% const formErrors = typeof errors !== "undefined" ? errors : []; %>
    <h1><%= copy('Scegli una nuova password', 'Choose a new password', 'Waehle ein neues Passwort') %></h1>
    <% if (!valid) { %>
      <div class="error-box"><%= copy('Il link non e valido o e scaduto. Richiedi un nuovo link dalla pagina di recupero password', 'The link is invalid or expired. Request a new link from the password reset page', 'Der Link ist ungueltig oder abgelaufen. Fordere einen neuen Link auf der Passwortseite an') %></div>
      <p class="auth-link"><a href="/forgot-password"><%= copy('Richiedi un nuovo link', 'Request a new link', 'Neuen Link anfordern') %></a></p>
    <% } else { %>
      <p><%= copy('La nuova password deve avere almeno 8 caratteri', 'The new password must be at least 8 characters long', 'Das neue Passwort muss mindestens 8 Zeichen lang sein') %></p>
      <% if (formErrors.length) { %>
        <div class="error-box"><%= formErrors.join(" ") %></div>
      <% } %>
      <form method="post" action="/reset-password/<%= token %>" class="stack-form">
        <label><%= copy('Nuova password', 'New password', 'Neues Passwort') %><input type="password" name="password" autocomplete="new-password" minlength="8" required /></label>
        <label><%= copy('Conferma password', 'Confirm password', 'Passwort bestaetigen') %><input type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required /></label>
        <button type="submit" class="primary-btn"><%= copy('Aggiorna password', 'Update password', 'Passwort aktualisieren') %></button>
      </form>
    <% } %>
    <p class="auth-link"><a href="/login"><%= copy('Torna al login', 'Back to login', 'Zurueck zum Login') %></a></p>
  </div>
</section>
