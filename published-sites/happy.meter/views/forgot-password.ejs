<section class="auth-wrap">
  <div class="auth-card">
    <% const formErrors = typeof errors !== "undefined" ? errors : []; %>
    <% const formValues = typeof values !== "undefined" ? values : {}; %>
    <h1><%= copy('Recupera password', 'Reset password', 'Passwort zuruecksetzen') %></h1>
    <p><%= copy('Inserisci la tua email e ti invieremo un link sicuro per scegliere una nuova password', 'Enter your email and we will send you a secure link to choose a new password', 'Gib deine E Mail ein und wir senden dir einen sicheren Link fuer ein neues Passwort') %></p>
    <% if (formErrors.length) { %>
      <div class="error-box"><%= formErrors.join(" ") %></div>
    <% } %>
    <form method="post" action="/forgot-password" class="stack-form">
      <label><%= copy('Email', 'Email', 'E Mail') %><input type="email" name="email" value="<%= formValues.email || '' %>" autocomplete="email" required /></label>
      <button type="submit" class="primary-btn"><%= copy('Invia link di recupero', 'Send reset link', 'Link senden') %></button>
    </form>
    <p class="auth-link"><a href="/login"><%= copy('Torna al login', 'Back to login', 'Zurueck zum Login') %></a></p>
  </div>
</section>
